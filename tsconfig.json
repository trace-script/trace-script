{
  "extends": "./packages/tsconfig/base.json",
  "compilerOptions": {
    "lib": [
      "ESNext",
      "DOM",
      "DOM.Iterable"
    ],
    "paths": {
      "@/*": [
        "./packages/core/src/*"
      ],
      "@trace-script/core": [
        "./packages/core/src/index.ts"
      ],
      "@trace-script/metadata": [
        "./packages/metadata/src/index.ts"
      ],
      "@trace-script/sdk": [
        "./packages/sdk/src/index.ts"
      ],
      "@trace-script/shared": [
        "./packages/shared/src/index.ts"
      ]
    },
    "types": [
      "node",
      "vitest/importMeta",
      "chrome"
    ],
    "allowJs": true,
    "noEmit": true
  },
  "include": [
    "packages/*/src/**/*.ts",
    "scripts",
    "fixtures"
  ]
}
