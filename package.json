{
  "name": "trace-script",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "description": "Trace Script \u2014 Visualize Agent event streams right in your browser extension. Trace every call with the same intuitive clarity as the Network panel.",
  "author": "lonewolfyx <https://github.com/lonewolfyx>",
  "license": "MIT",
  "scripts": {
    "dev": "turbo run dev",
    "dev:panel": "turbo run dev:panel",
    "build": "turbo run build",
    "build:dev": "turbo run build && turbo run build:dev --filter=@trace-script/chrome-extensions",
    "package:chrome": "pnpm --filter @trace-script/chrome-extensions package:chrome",
    "typecheck": "turbo run typecheck typecheck:root && turbo run typecheck:panel --filter=@trace-script/chrome-extensions",
    "typecheck:root": "vue-tsc --noEmit -p tsconfig.json",
    "test:cov": "vitest --coverage",
    "test": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint --fix",
    "prepare": "simple-git-hooks",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:lint",
    "@fontsource/geist-mono": "catalog:ui",
    "@fontsource/geist-sans": "catalog:ui",
    "@playwright/test": "catalog:test",
    "@trace-script/tsconfig": "workspace:*",
    "@types/chrome": "catalog:types",
    "@types/node": "catalog:types",
    "@vitejs/plugin-vue": "catalog:build",
    "@vitest/coverage-v8": "catalog:test",
    "@vue/test-utils": "catalog:test",
    "eslint": "catalog:lint",
    "eslint-factory": "catalog:lint",
    "eslint-plugin-format": "catalog:lint",
    "fake-indexeddb": "catalog:test",
    "happy-dom": "catalog:test",
    "jiti": "catalog:dev",
    "lint-staged": "catalog:lint",
    "simple-git-hooks": "catalog:dev",
    "tsdown": "catalog:build",
    "tsx": "catalog:dev",
    "turbo": "catalog:build",
    "typescript": "catalog:dev",
    "unplugin-vue": "catalog:build",
    "verify-git-commit": "catalog:dev",
    "vite": "catalog:build",
    "vitest": "catalog:test",
    "vue": "catalog:ui",
    "vue-tsc": "catalog:dev"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged",
    "commit-msg": "node scripts/verify-commit.mjs \"$1\""
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
