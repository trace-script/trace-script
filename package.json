{
  "name": "trace-script",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "description": "Trace Script — Visualize Agent event streams right in your browser extension. Trace every call with the same intuitive clarity as the Network panel.",
  "author": "lonewolfyx <https://github.com/lonewolfyx>",
  "license": "MIT",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck typecheck:root",
    "typecheck:root": "vue-tsc --noEmit -p tsconfig.json",
    "test:cov": "vitest --coverage",
    "test": "vitest",
    "lint": "pnpm --filter @trace-script/eslint-rules build && eslint .",
    "lint:fix": "pnpm --filter @trace-script/eslint-rules build && eslint --fix",
    "prepare": "simple-git-hooks"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:lint",
    "@trace-script/eslint-rules": "workspace:*",
    "@trace-script/tsconfig": "workspace:*",
    "@types/chrome": "catalog:types",
    "@types/node": "catalog:types",
    "@vitejs/plugin-vue": "catalog:build",
    "@vitest/coverage-v8": "catalog:test",
    "@vue/test-utils": "catalog:test",
    "eslint": "catalog:lint",
    "eslint-plugin-format": "catalog:lint",
    "happy-dom": "catalog:test",
    "lint-staged": "catalog:lint",
    "simple-git-hooks": "catalog:dev",
    "tsdown": "catalog:build",
    "tsx": "catalog:dev",
    "turbo": "catalog:build",
    "typescript": "catalog:dev",
    "vite": "catalog:build",
    "vitest": "catalog:test",
    "vue": "catalog:ui",
    "vue-tsc": "catalog:dev"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged",
    "commit-msg": "node scripts/verify-commit.mjs \"$1\""
  },
  "lint-staged": {
    "*": "pnpm lint:fix --"
  }
}
