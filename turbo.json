{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "dist-dev/**"]
    },
    "build:dev": {
      "dependsOn": ["^build"],
      "outputs": ["dist-dev/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "typecheck:panel": {},
    "//#typecheck:root": {},
    "dev": {
      "cache": false,
      "persistent": true
    },
    "dev:panel": {
      "cache": false,
      "persistent": true
    }
  }
}
