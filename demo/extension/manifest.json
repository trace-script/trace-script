{
  "manifest_version": 3,
  "name": "Agent Trace Demo",
  "version": "0.1.1",
  "description": "Receive simulated ChatGPT trace events from a local page in Chrome DevTools.",
  "minimum_chrome_version": "112",
  "background": {
    "service_worker": "background.js"
  },
  "devtools_page": "devtools.html",
  "content_scripts": [
    {
      "matches": ["http://localhost/*", "http://127.0.0.1/*"],
      "js": ["protocol.js", "content-script.js"],
      "run_at": "document_start"
    }
  ]
}
