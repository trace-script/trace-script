{
  "name": "@trace-script/eslint-rules",
  "type": "module",
  "private": true,
  "description": "Repository-specific ESLint rules for @trace-script.",
  "author": "NoiseFan <https://github.com/NoiseFan>",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "test": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@trace-script/shared": "workspace:*",
    "eslint-factory": "catalog:lint",
    "vue-eslint-parser": "catalog:lint"
  },
  "devDependencies": {
    "@trace-script/tsconfig": "workspace:*",
    "@types/node": "catalog:types",
    "eslint": "catalog:lint",
    "typescript": "catalog:dev",
    "vitest": "catalog:test"
  }
}
