{
  "name": "@trace-script/eslint-rules",
  "type": "module",
  "private": true,
  "description": "Repository-specific ESLint rules for Trace Script.",
  "author": "NoiseFan <https://github.com/NoiseFan>",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./src/index.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "eslint-factory": "catalog:lint"
  },
  "devDependencies": {
    "@trace-script/tsconfig": "workspace:*",
    "@types/node": "catalog:types",
    "tsdown": "catalog:build",
    "typescript": "catalog:dev"
  }
}
