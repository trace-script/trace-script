{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": [
    "@trace-script/tsconfig/base.json"
  ],
  "compilerOptions": {
    "paths": {
      "@/panel/*": ["./panel/*"],
      "@/extension/*": ["./extension/*"],
      "@/scripts/*": ["./scripts/*"]
    },
    "types": [
      "chrome",
      "node"
    ]
  },
  "include": ["apps", "scripts", "tsdown.config.ts"]
}
