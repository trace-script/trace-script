{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": [
    "@trace-script/tsconfig/base.json"
  ],
  "compilerOptions": {
    "paths": {
      "@/panel/*": ["./apps/panel/*"],
      "@/extension/*": ["./apps/extension/*"],
      "@/scripts/*": ["./scripts/*"]
    },
    "types": [
      "chrome",
      "node"
    ]
  },
  "include": ["apps/extension", "scripts", "tsdown.config.ts"],
  "exclude": ["app/panel"]
}
