{
  "extends": "./.nuxt/tsconfig.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": [
      "chrome",
      "node"
    ]
  },
  "include": [
    "scripts",
    "tests",
    "src",
    "./.nuxt/nuxt.d.ts",
    "./.nuxt/nuxt.node.d.ts",
    "./nuxt.config.*",
    "./vitest.config.ts"
  ]
}
