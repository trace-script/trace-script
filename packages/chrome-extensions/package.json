{
  "name": "@trace-script/chrome-extensions",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Trace Script - Visualize Agent event streams right in your browser extension. Trace every call with the same intuitive clarity as the Network panel.",
  "author": "lonewolfyx <https://github.com/lonewolfyx>",
  "license": "MIT",
  "homepage": "https://github.com/trace-script/trace-script#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trace-script/trace-script.git",
    "directory": "packages/chrome-extensions"
  },
  "bugs": {
    "url": "https://github.com/trace-script/trace-script/issues"
  },
  "keywords": [
    "agent",
    "trace",
    "extensions",
    "chrome-extensions",
    "trace-script"
  ],
  "scripts": {
    "build": "tsdown --config-loader tsx",
    "build:dev": "TRACE_SCRIPT_BUILD_MODE=development tsdown --config-loader tsx",
    "dev": "TRACE_SCRIPT_BUILD_MODE=development tsdown --config-loader tsx --watch",
    "dev:panel": "nuxt dev apps/panel",
    "typecheck": "tsc --noEmit",
    "typecheck:panel": "nuxt typecheck apps/panel",
    "package:chrome": "pnpm build && tsx scripts/package.ts",
    "prepare:panel": "nuxt prepare apps/panel"
  },
  "dependencies": {
    "class-variance-authority": "catalog:ui",
    "vue": "catalog:ui"
  },
  "devDependencies": {
    "@tailwindcss/vite": "catalog:build",
    "@trace-script/tsconfig": "workspace:*",
    "@types/chrome": "catalog:types",
    "@types/node": "catalog:types",
    "nuxt": "catalog:build",
    "shadcn-nuxt": "catalog:build",
    "tailwindcss": "catalog:build",
    "tsdown": "catalog:build",
    "tsx": "catalog:dev",
    "typescript": "catalog:dev",
    "vue-tsc": "catalog:dev"
  }
}
