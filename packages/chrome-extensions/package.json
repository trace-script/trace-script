{
  "name": "@trace-script/chrome-extensions",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Trace Script - Visualize Agent event streams right in your browser extension. Trace every call with the same intuitive clarity as the Network panel.",
  "author": "lonewolfyx <https://github.com/lonewolfyx>",
  "license": "MIT",
  "homepage": "https://github.com/trace-script/trace-script#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trace-script/trace-script.git",
    "directory": "packages/chrome-extensions"
  },
  "bugs": {
    "url": "https://github.com/trace-script/trace-script/issues"
  },
  "keywords": [
    "agent",
    "trace",
    "extensions",
    "chrome-extensions",
    "trace-script"
  ],
  "scripts": {
    "build": "tsx scripts/build-extension.ts",
    "dev": "nuxt dev",
    "dev:extension": "tsx scripts/build-extension.ts --development",
    "postinstall": "nuxt prepare",
    "test": "vitest",
    "typecheck": "nuxt typecheck"
  },
  "dependencies": {
    "@iconify/vue": "catalog:",
    "@trace-script/core": "workspace:*",
    "@trace-script/shared": "workspace:*",
    "@trace-script/vue-components": "workspace:*",
    "@vueuse/core": "catalog:",
    "vue": "catalog:ui"
  },
  "devDependencies": {
    "@nuxt/eslint": "catalog:lint",
    "@tailwindcss/vite": "catalog:build",
    "@trace-script/metadata": "workspace:*",
    "@types/chrome": "catalog:types",
    "@types/node": "catalog:types",
    "nuxt": "catalog:build",
    "tailwindcss": "catalog:build",
    "tsx": "catalog:dev",
    "typescript": "catalog:dev",
    "vite": "catalog:build"
  }
}
