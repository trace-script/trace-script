{
  "name": "@trace-script/sdk",
  "type": "module",
  "version": "0.0.0",
  "description": "Trace Script \u2014 Visualize Agent event streams right in your browser extension. Trace every call with the same intuitive clarity as the Network panel.",
  "author": "lonewolfyx <https://github.com/lonewolfyx>",
  "license": "MIT",
  "homepage": "https://github.com/trace-script/trace-script#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trace-script/trace-script.git",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/trace-script/trace-script/issues"
  },
  "keywords": [
    "agent",
    "trace",
    "extensions",
    "chrome-extensions",
    "trace-script"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@trace-script/metadata": "workspace:*",
    "@trace-script/shared": "workspace:*"
  },
  "devDependencies": {
    "@trace-script/tsconfig": "workspace:*",
    "tsdown": "catalog:build",
    "typescript": "catalog:dev"
  }
}
